.a-hero {
  background: linear-gradient(160deg, #F47735, #FFC499);
  padding: 100rpx 0 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.a-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #fff;
  color: #F47735;
  font-size: 72rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 30rpx rgba(0,0,0,0.15);
}
.a-name { color: #fff; font-size: 44rpx; font-weight: 700; margin-top: 24rpx; }
.a-role { color: rgba(255,255,255,0.9); font-size: 24rpx; margin-top: 8rpx; }

.a-para {
  font-size: 28rpx;
  color: #4A4239;
  line-height: 2;
  margin-bottom: 28rpx;
}

.ms {
  display: flex;
  margin-top: 28rpx;
  align-items: flex-start;
}
.ms-year {
  flex-shrink: 0;
  width: 110rpx;
  color: #F47735;
  font-weight: 700;
}
.ms-text {
  flex: 1;
  font-size: 26rpx;
  color: #6B6259;
  border-left: 2rpx solid #E5D9CC;
  padding-left: 24rpx;
  line-height: 1.8;
}

.quote {
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
  color: #F47735;
  line-height: 1.5;
  padding: 20rpx 40rpx;
}
