.filter-scroll { white-space: nowrap; margin-top: 28rpx; }
.filter-row { display: inline-flex; padding: 0 32rpx; }
.filter-chip {
  flex-shrink: 0;
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #6B6259;
  font-size: 26rpx;
  margin-right: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(120,90,60,0.06);
}
.filter-chip.on {
  background: #F47735;
  color: #fff;
  font-weight: 600;
}
.chip-light.on { background: #123D67; }
.result-count { margin: 32rpx 0 20rpx; }
.empty { text-align: center; padding: 120rpx 0; }
.empty-emoji { font-size: 80rpx; }
.empty-text { font-size: 30rpx; font-weight: 600; margin: 24rpx 0 8rpx; }
