.addon {
  margin-top: 24rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  border: 2rpx solid transparent;
}
.addon.on {
  border-color: #F47735;
  background: #FFFBF7;
}
.addon-icon { font-size: 56rpx; margin-right: 24rpx; }
.addon-body { flex: 1; }
.addon-name { font-weight: 700; font-size: 30rpx; margin-bottom: 4rpx; }
.addon-price { color: #F47735; font-size: 24rpx; font-weight: 600; margin-top: 8rpx; }
.addon-check {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid #E5D9CC;
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 20rpx;
}
.addon.on .addon-check {
  background: #F47735;
  border-color: #F47735;
}
