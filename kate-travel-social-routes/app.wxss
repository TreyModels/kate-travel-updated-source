/* 凯特旅行 全局样式 — 暖色自然系 */
page {
  background: #F3F8FC;
  color: #123D67;
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

.container {
  padding: 0 32rpx;
  box-sizing: border-box;
}

/* 排版 */
.h1 { font-size: 48rpx; font-weight: 700; line-height: 1.25; letter-spacing: 1rpx; }
.h2 { font-size: 38rpx; font-weight: 700; line-height: 1.3; }
.h3 { font-size: 30rpx; font-weight: 600; }
.muted { color: #668099; }
.small { font-size: 24rpx; }
.accent { color: #F47735; }

/* 区块标题 */
.section {
  margin-top: 56rpx;
}
.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.section-more {
  font-size: 24rpx;
  color: #F47735;
}

/* 卡片 */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(120, 90, 60, 0.08);
  overflow: hidden;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: #F5EDE4;
  color: #8A7A6A;
  margin-right: 12rpx;
}
.tag-accent {
  background: #FBE9DF;
  color: #F47735;
}

/* 状态徽章 */
.badge {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}
.badge-recruiting { background: #E8F3EC; color: #3F7D5A; }
.badge-confirmed  { background: #FBE9DF; color: #F47735; }
.badge-full       { background: #EFEBE6; color: #668099; }
.badge-planning   { background: #EAF0F6; color: #5A7391; }

/* 按钮 */
.btn-primary {
  background: #F47735;
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  padding: 24rpx 0;
  box-shadow: 0 10rpx 24rpx rgba(201, 111, 74, 0.32);
}
.btn-primary::after { border: none; }
.btn-ghost {
  background: transparent;
  color: #F47735;
  border: 2rpx solid #F47735;
  border-radius: 999rpx;
  font-size: 28rpx;
  text-align: center;
  padding: 20rpx 0;
}
.btn-ghost::after { border: none; }

.divider {
  height: 1rpx;
  background: #EFE7DE;
  margin: 32rpx 0;
}

/* 页面底部留白，避开自定义 tabBar */
.page-safe-bottom {
  padding-bottom: 160rpx;
}
