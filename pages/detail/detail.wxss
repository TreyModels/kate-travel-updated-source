.d-cover {
  height: 460rpx;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
  display: flex;
  align-items: flex-end;
  position: relative;
  overflow: hidden;
}
.d-cover-emoji {
  position: absolute;
  right: 30rpx;
  top: 60rpx;
  font-size: 180rpx;
  opacity: 0.35;
}
.d-title { color: #fff; font-size: 44rpx; font-weight: 700; margin-top: 16rpx; }
.d-tagline { color: rgba(255,255,255,0.92); font-size: 26rpx; margin-top: 10rpx; }
.d-meta { color: rgba(255,255,255,0.85); font-size: 24rpx; margin-top: 16rpx; }

.theme-sea    { background: linear-gradient(135deg, #3E7C8C 0%, #7FB3B0 60%, #C8D8C5 100%); }
.theme-sunset { background: linear-gradient(135deg, #B85C49 0%, #E08E63 55%, #F2C48D 100%); }
.theme-temple { background: linear-gradient(135deg, #6B4F3A 0%, #A9825A 55%, #D9BC8A 100%); }
.theme-river  { background: linear-gradient(135deg, #4A6B57 0%, #7D9B76 60%, #C9D6A3 100%); }
.theme-city   { background: linear-gradient(135deg, #5A5E73 0%, #8A8FA8 55%, #CBB8C9 100%); }
.theme-forest { background: linear-gradient(135deg, #3C5A44 0%, #6E8F62 60%, #B5C98D 100%); }

.dep {
  padding: 28rpx;
  margin-top: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.dep-date { font-weight: 700; font-size: 30rpx; }
.dep-right { display: flex; flex-direction: column; align-items: flex-end; }
.dep-btn {
  margin-top: 14rpx;
  background: #C96F4A;
  color: #fff;
  font-size: 24rpx;
  padding: 10rpx 32rpx;
  border-radius: 999rpx;
}
.dep-btn-disabled { background: #B9AFA4; }

.hl-wrap { display: flex; flex-wrap: wrap; margin-top: 16rpx; }
.hl-chip {
  background: #fff;
  border-radius: 12rpx;
  padding: 14rpx 24rpx;
  font-size: 24rpx;
  color: #6B6259;
  margin: 0 16rpx 16rpx 0;
  box-shadow: 0 4rpx 12rpx rgba(120,90,60,0.06);
}

.day { display: flex; margin-bottom: 20rpx; }
.day-num {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #C96F4A;
  color: #fff;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}
.day-body { flex: 1; padding: 26rpx 28rpx; }
.day-title { font-weight: 600; font-size: 28rpx; margin-bottom: 8rpx; }
.day-desc { font-size: 24rpx; color: #6B6259; line-height: 1.7; }
.day-foot { margin-top: 14rpx; }

.hotel { padding: 26rpx 28rpx; margin-top: 16rpx; }
.hotel-name { font-weight: 600; margin-bottom: 6rpx; }

.up {
  padding: 26rpx 28rpx;
  margin-top: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.up-name { font-weight: 600; margin-bottom: 4rpx; }
.up-price { color: #C96F4A; font-weight: 700; font-size: 30rpx; flex-shrink: 0; margin-left: 24rpx; }

.fee { padding: 32rpx 28rpx; margin-top: 16rpx; }
.fee-block { margin-bottom: 28rpx; }
.fee-block:last-child { margin-bottom: 0; }
.fee-title { font-weight: 600; margin-bottom: 10rpx; }
.fee-item { font-size: 24rpx; color: #6B6259; margin-top: 6rpx; }

.host { padding: 28rpx; margin-top: 16rpx; display: flex; align-items: center; }
.host-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E08E63, #C96F4A);
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}
.host-name { font-weight: 700; margin-bottom: 4rpx; }

.operator { padding: 32rpx 28rpx; margin-top: 16rpx; }

.d-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  box-shadow: 0 -4rpx 24rpx rgba(120,90,60,0.1);
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 50;
}
.d-price-num { color: #C96F4A; font-size: 40rpx; font-weight: 700; }
.d-bar-actions { display: flex; align-items: center; }
.d-bar-ghost {
  border: 2rpx solid #C96F4A;
  color: #C96F4A;
  border-radius: 999rpx;
  padding: 16rpx 36rpx;
  font-size: 26rpx;
  margin-right: 16rpx;
}
.d-bar-primary {
  background: #C96F4A;
  color: #fff;
  border-radius: 999rpx;
  padding: 18rpx 48rpx;
  font-size: 28rpx;
  font-weight: 600;
}
