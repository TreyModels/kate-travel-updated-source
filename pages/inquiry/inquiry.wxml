<view wx:if="{{!submitted}}" class="page-safe-bottom">
  <view class="container" style="padding-top:32rpx;">
    <view class="h1">咨询报名</view>
    <view class="muted small" style="margin-top:8rpx;">
      留下联系方式，Kate 或旅行顾问会在 24 小时内联系你。正式合同与收款由持牌旅行社完成。
    </view>

    <!-- 行程摘要 -->
    <view class="sum card" wx:if="{{trip}}">
      <view class="sum-title">{{trip.title}}</view>
      <view class="muted small">{{trip.days}} 天 {{trip.nights}} 晚 · ¥{{trip.price}} 起 · {{trip.statusText}}</view>
      <view class="sum-dates">
        <view
          wx:for="{{trip.departures}}"
          wx:key="date"
          class="date-chip {{date === item.date ? 'on' : ''}}"
          data-date="{{item.date}}"
          bindtap="pickDate"
        >{{item.date}}</view>
      </view>
    </view>

    <!-- 表单 -->
    <view class="form card">
      <view class="field">
        <view class="label">怎么称呼你 *</view>
        <input class="input" placeholder="例如：小桃" data-field="name" value="{{form.name}}" bindinput="onInput" />
      </view>
      <view class="field">
        <view class="label">你的微信号 *</view>
        <input class="input" placeholder="方便顾问加你" data-field="wechat" value="{{form.wechat}}" bindinput="onInput" />
      </view>
      <view class="field">
        <view class="label">手机号（选填）</view>
        <input class="input" type="number" placeholder="仅用于行程通知" data-field="phone" value="{{form.phone}}" bindinput="onInput" />
      </view>
      <view class="field">
        <view class="label">所在城市（选填）</view>
        <input class="input" placeholder="例如：广州" data-field="city" value="{{form.city}}" bindinput="onInput" />
      </view>
      <view class="field">
        <view class="label">同行人数</view>
        <picker mode="selector" range="{{peopleOptions}}" value="{{peopleIndex}}" bindchange="onPeopleChange">
          <view class="input picker-input">{{peopleOptions[peopleIndex]}} ▾</view>
        </picker>
      </view>
      <view class="field">
        <view class="label">想说的话（选填）</view>
        <textarea class="textarea" placeholder="想了解的细节、时间偏好、或想去的其他地方…" data-field="note" value="{{form.note}}" bindinput="onInput" />
      </view>
    </view>

    <view class="btn-primary" style="margin-top:32rpx;" bindtap="submit">提交咨询</view>
    <view class="muted small" style="text-align:center;margin-top:20rpx;">
      提交即表示同意我们就本次咨询与你联系，信息仅用于行程服务
    </view>
  </view>
</view>

<!-- 提交成功 -->
<view wx:else class="success">
  <text class="success-emoji">🎉</text>
  <view class="h2" style="margin-top:24rpx;">收到你的咨询啦</view>
  <view class="muted" style="margin:16rpx 0 8rpx;text-align:center;">
    顾问会尽快加你微信确认细节，也可以主动加 Kate：
  </view>
  <view class="success-wechat" bindtap="copyWechat">{{serviceWechat}}（点我复制）</view>
  <view class="btn-primary success-btn" bindtap="goMine">去「我的」查看咨询进度</view>
</view>
