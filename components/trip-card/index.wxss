.trip-card { margin-bottom: 32rpx; }

.cover {
  height: 300rpx;
  padding: 28rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  position: relative;
  overflow: hidden;
}
.cover-emoji {
  position: absolute;
  right: 24rpx;
  bottom: 60rpx;
  font-size: 140rpx;
  opacity: 0.35;
}
.cover-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.cover-country {
  color: rgba(255,255,255,0.92);
  font-size: 24rpx;
  letter-spacing: 4rpx;
  background: rgba(0,0,0,0.18);
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
}
.cover-tagline {
  color: #fff;
  font-size: 26rpx;
  opacity: 0.95;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.25);
}

/* 目的地主题渐变色（无图模式下的视觉封面） */
.theme-sea    { background: linear-gradient(135deg, #3E7C8C 0%, #7FB3B0 60%, #C8D8C5 100%); }
.theme-sunset { background: linear-gradient(135deg, #B85C49 0%, #E08E63 55%, #F2C48D 100%); }
.theme-temple { background: linear-gradient(135deg, #6B4F3A 0%, #A9825A 55%, #D9BC8A 100%); }
.theme-river  { background: linear-gradient(135deg, #4A6B57 0%, #7D9B76 60%, #C9D6A3 100%); }
.theme-city   { background: linear-gradient(135deg, #5A5E73 0%, #8A8FA8 55%, #CBB8C9 100%); }
.theme-forest { background: linear-gradient(135deg, #3C5A44 0%, #6E8F62 60%, #B5C98D 100%); }

.body { padding: 28rpx; }
.title { font-size: 32rpx; font-weight: 700; margin-bottom: 10rpx; }
.meta { font-size: 24rpx; color: #9A8F85; margin-bottom: 14rpx; }
.dot { margin: 0 8rpx; }
.hl { display: flex; flex-wrap: wrap; margin-bottom: 20rpx; }
.hl-item {
  font-size: 22rpx;
  color: #8A7A6A;
  background: #F5EDE4;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
  margin: 0 10rpx 10rpx 0;
}
.foot {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}
.price-num { color: #C96F4A; font-size: 40rpx; font-weight: 700; }
.price-unit { color: #9A8F85; font-size: 22rpx; }
.cta { color: #C96F4A; font-size: 26rpx; font-weight: 600; }
