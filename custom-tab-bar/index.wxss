.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 120rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #FFFFFF;
  box-shadow: 0 -4rpx 24rpx rgba(120, 90, 60, 0.08);
  display: flex;
  z-index: 100;
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #9A8F85;
}
.tab-item.active { color: #C96F4A; }
.tab-text { font-size: 20rpx; margin-top: 4rpx; }

.icon {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

/* home：屋顶 + 房身 */
.shape-home {
  width: 26rpx;
  height: 20rpx;
  border: 3rpx solid currentColor;
  border-top: none;
  position: relative;
  margin-top: 10rpx;
}
.shape-home::before {
  content: '';
  position: absolute;
  top: -19rpx;
  left: -9rpx;
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid currentColor;
  border-right: none;
  border-bottom: none;
  transform: rotate(45deg);
}

/* compass：圆 + 指针 */
.shape-compass {
  width: 34rpx;
  height: 34rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.needle {
  width: 0;
  height: 0;
  border-left: 6rpx solid transparent;
  border-right: 6rpx solid transparent;
  border-bottom: 16rpx solid currentColor;
  transform: rotate(45deg);
}

/* heart：两个圆 + 菱形 */
.shape-heart {
  width: 26rpx;
  height: 26rpx;
  background: currentColor;
  transform: rotate(45deg);
  border-radius: 4rpx;
  position: relative;
  margin-bottom: 6rpx;
}
.shape-heart::before,
.shape-heart::after {
  content: '';
  position: absolute;
  width: 26rpx;
  height: 26rpx;
  background: currentColor;
  border-radius: 50%;
}
.shape-heart::before { left: -13rpx; top: 0; }
.shape-heart::after { left: 0; top: -13rpx; }

/* user：头 + 肩 */
.shape-user {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.shape-user .head {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: currentColor;
}
.shape-user .body {
  width: 32rpx;
  height: 16rpx;
  border-radius: 16rpx 16rpx 0 0;
  background: currentColor;
  margin-top: 4rpx;
}
